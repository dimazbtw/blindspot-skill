{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scorecard",
  "description": "The scored result of one run. Generated by scripts/compute_scores.py from the findings record and the coverage ledger; the orchestrator may add bounded judgment adjustments and justifications but never edits computed values by hand.",
  "type": "object",
  "required": ["schema_version", "site", "run", "categories", "global", "task_metrics", "first_impression_metrics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "site": {
      "type": "object",
      "required": ["url", "slug", "type"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 4 },
        "slug": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "required": ["number", "mode", "date", "evidence_tier", "isolation", "weight_profile"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "mode": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "evidence_tier": { "enum": ["rendered", "provided", "text"] },
        "isolation": { "enum": ["full", "degraded"] },
        "weight_profile": { "enum": ["default", "transactional", "app", "content"] }
      }
    },
    "categories": {
      "type": "object",
      "required": ["clarity", "navigation", "trust", "content", "design", "flows", "mobile", "accessibility"],
      "additionalProperties": false,
      "properties": {
        "clarity": { "$ref": "#/$defs/category_result" },
        "navigation": { "$ref": "#/$defs/category_result" },
        "trust": { "$ref": "#/$defs/category_result" },
        "content": { "$ref": "#/$defs/category_result" },
        "design": { "$ref": "#/$defs/category_result" },
        "flows": { "$ref": "#/$defs/category_result" },
        "mobile": { "$ref": "#/$defs/category_result" },
        "accessibility": { "$ref": "#/$defs/category_result" }
      }
    },
    "global": {
      "type": "object",
      "required": ["score", "band", "assessed_weight", "confidence", "provisional", "floor_warning", "note"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "band": { "enum": ["excellent", "good", "fair", "poor", "failing", "not_rated"] },
        "assessed_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "enum": ["none", "low", "medium", "high"] },
        "provisional": { "type": "boolean" },
        "floor_warning": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "task_metrics": {
      "type": "object",
      "required": [
        "attempted",
        "success_rate",
        "difficulty_rate",
        "abandon_rate",
        "incorrect_rate",
        "blocked_count",
        "mean_efficiency",
        "first_click_success_rate",
        "by_persona"
      ],
      "additionalProperties": false,
      "properties": {
        "attempted": { "type": "integer", "minimum": 0 },
        "success_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "difficulty_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "abandon_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "incorrect_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "mean_efficiency": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "first_click_success_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "by_persona": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "persona",
              "attempted",
              "completed",
              "completed_with_difficulty",
              "completed_incorrectly",
              "abandoned",
              "blocked"
            ],
            "additionalProperties": false,
            "properties": {
              "persona": { "type": "string" },
              "attempted": { "type": "integer", "minimum": 0 },
              "completed": { "type": "integer", "minimum": 0 },
              "completed_with_difficulty": { "type": "integer", "minimum": 0 },
              "completed_incorrectly": { "type": "integer", "minimum": 0 },
              "abandoned": { "type": "integer", "minimum": 0 },
              "blocked": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "first_impression_metrics": {
      "type": "object",
      "required": [
        "personas_tested",
        "understood_what",
        "understood_audience",
        "understood_action",
        "mean_gut_rating",
        "would_continue_rate"
      ],
      "additionalProperties": false,
      "properties": {
        "personas_tested": { "type": "integer", "minimum": 0 },
        "understood_what": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "understood_audience": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "understood_action": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "mean_gut_rating": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
        "would_continue_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "persona_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["persona", "would_return", "would_recommend", "one_line"],
        "additionalProperties": false,
        "properties": {
          "persona": { "type": "string" },
          "would_return": { "enum": ["yes", "maybe", "no"] },
          "would_recommend": { "enum": ["yes", "maybe", "no"] },
          "one_line": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "finding_counts": {
      "type": "object",
      "required": ["blocker", "major", "moderate", "minor"],
      "additionalProperties": false,
      "properties": {
        "blocker": { "type": "integer", "minimum": 0 },
        "major": { "type": "integer", "minimum": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "category_result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "weight",
            "computed_score",
            "adjustment",
            "adjustment_reason",
            "final_score",
            "confidence",
            "coverage",
            "caps_applied",
            "finding_counts",
            "needs_validation_count",
            "justification"
          ],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "assessed" },
            "weight": { "type": "number", "minimum": 0, "maximum": 100 },
            "computed_score": { "type": "number", "minimum": 0, "maximum": 10 },
            "adjustment": { "type": "number", "minimum": -1, "maximum": 1 },
            "adjustment_reason": { "type": "string" },
            "final_score": { "type": "number", "minimum": 0, "maximum": 10 },
            "confidence": { "enum": ["low", "medium", "high"] },
            "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "caps_applied": { "type": "array", "items": { "type": "string" } },
            "finding_counts": { "$ref": "#/$defs/finding_counts" },
            "needs_validation_count": { "type": "integer", "minimum": 0 },
            "justification": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["status", "weight", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "not_assessed" },
            "weight": { "type": "number", "minimum": 0, "maximum": 100 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
